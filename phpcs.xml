<?xml version="1.0"?>
<ruleset name="Braspag WooCommerce Plugin">

    <description>WordPress and WooCommerce coding standards.</description>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="p"/>

    <file>includes</file>
    <file>src</file>
    <file>templates</file>
    <file>woocommerce-braspag.php</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>
    <exclude-pattern>assets/*</exclude-pattern>

    <config name="testVersion" value="7.4-8.3"/>

    <rule ref="WordPress"/>
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="wc_braspag"/>
                <element value="braspag"/>
                <element value="WC_Braspag"/>
            </property>
        </properties>
    </rule>

</ruleset>