{
  "name": "woocommerce-braspag",
  "version": "2.3.5.44",
  "private": true,
  "description": "WooCommerce Braspag payment gateway – JS test suite",
  "scripts": {
    "test:js": "jest",
    "test:js:watch": "jest --watch",
    "test:js:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@playwright/test": "^1.60.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/js/**/*.test.js"
    ],
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "coverageDirectory": "tests/js/coverage",
    "collectCoverageFrom": [
      "assets/js/blocks/*.js"
    ]
  }
}
